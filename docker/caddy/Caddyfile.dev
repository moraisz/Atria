{
    # 0 keeps FrankenPHP's automatic sizing (2 threads per CPU); see .env.example
    frankenphp {
        num_threads {$FRANKENPHP_NUM_THREADS:0}
        max_threads {$FRANKENPHP_MAX_THREADS:0}
        max_wait_time {$FRANKENPHP_MAX_WAIT_TIME:0s}
    }
    admin 0.0.0.0:2019
}

{$APP_DOMAIN}, http://127.0.0.1 {
    root * /app/public
    encode zstd br gzip

    mercure {
        publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY}
        subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY}
        anonymous
    }

    php_server {
        try_files {path} /index.php
        root /app/public

        hot_reload
        worker {
            file /app/public/index.php
            num {$FRANKENPHP_WORKERS:0}
            max_consecutive_failures 10
            watch
        }
    }

    log {
        output stdout
        format json
        level INFO
    }
}
