{
    frankenphp
    admin 0.0.0.0:2019
}

{$APP_DOMAIN}, http://127.0.0.1 {
    root * /app/public
    encode zstd br gzip

    mercure {
        publisher_jwt {$MERCURE_PUBLISHER_JWT_KEY}
        subscriber_jwt {$MERCURE_SUBSCRIBER_JWT_KEY}
        anonymous
    }

    php_server {
        try_files {path} /index.php
        root /app/public

        hot_reload
        worker {
            file /app/public/index.php
            max_consecutive_failures 10
            watch
        }
    }

    log {
        output stdout
        format json
        level INFO
    }
}
