{
    "name": "moraisz/atria",
    "description": "Complete Atria framework application with FrankenPHP integration.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.4",
        "moraisz/atria-core": "^0.0.1-alpha"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.95",
        "pestphp/pest": "^5.1",
        "phpstan/phpstan": "^2.2"
    },
    "scripts": {
        "cs-fix": "php-cs-fixer fix",
        "cs-check": "php-cs-fixer fix --dry-run --diff",
        "phpstan": "phpstan analyse --memory-limit=2G",
        "test": "pest"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Morais",
            "email": "marcosviniciusm99@gmail.com"
        }
    ],
    "config": {
        "optimize-autoloader": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
